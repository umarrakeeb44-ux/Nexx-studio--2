<style>
:root{--bg:#080711;--panel:#11101d;--panel2:#171427;--purple:#9b5cff;--blue:#48b9ff;--text:#f5f2ff;--muted:#aaa5bd;--line:#302942}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 75% 15%,#24143d 0,transparent 38%),var(--bg);color:var(--text);font-family:Inter,system-ui,Arial,sans-serif;min-height:100vh}
header{position:sticky;top:0;z-index:20;background:#080711d9;backdrop-filter:blur(18px);border-bottom:1px solid #ffffff16}
.nav{max-width:1180px;margin:auto;padding:16px 22px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-weight:900;letter-spacing:2px;font-size:21px}.brand span{color:var(--purple)}
nav{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}nav button{border:0;background:transparent;color:#c9c3d9;padding:10px 12px;border-radius:10px;font-size:13px;cursor:pointer;transition:.2s}nav button:hover,nav button.active{background:#9b5cff22;color:white}
main{max-width:1180px;margin:auto;padding:0 22px 70px}.page{display:none;min-height:calc(100vh - 76px);padding:70px 0 35px;animation:appear .35s ease}.page.active{display:block}@keyframes appear{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.hero{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:35px;min-height:65vh}.eyebrow{color:#bd8cff;text-transform:uppercase;letter-spacing:3px;font-size:12px;font-weight:800}.hero h1{font-size:clamp(44px,7vw,82px);line-height:.98;letter-spacing:-3px;margin:18px 0}.gradient{background:linear-gradient(100deg,#fff,#bb8aff 55%,#62caff);-webkit-background-clip:text;background-clip:text;color:transparent}.lead{color:var(--muted);font-size:17px;line-height:1.8;max-width:580px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{border:1px solid #a56cff88;border-radius:12px;padding:13px 19px;color:white;background:linear-gradient(110deg,#7536c8,#315b9b);font-weight:750;cursor:pointer;text-decoration:none;display:inline-block}.btn.secondary{background:#ffffff08;border-color:#ffffff2b}.visual{height:390px;border:1px solid #9b5cff55;border-radius:28px;background:radial-gradient(circle at 50% 45%,#6338a766,transparent 48%),linear-gradient(145deg,#211737,#0b0a14);display:grid;place-items:center;position:relative;overflow:hidden;box-shadow:0 25px 90px #672bb533}.orb{width:210px;height:210px;border-radius:35%;border:2px solid #b68aff;box-shadow:0 0 35px #9b5cff, inset 0 0 35px #9b5cff66;transform:rotate(35deg);animation:float 5s ease-in-out infinite}.orb:before,.orb:after{content:"";position:absolute;inset:20px;border:1px solid #58c8ff;border-radius:35%;transform:rotate(35deg)}.orb:after{inset:-30px;border-color:#9b5cff66;transform:rotate(70deg)}@keyframes float{50%{transform:rotate(55deg) translateY(-14px)}}
.section-head{margin-bottom:28px}.section-head h1{font-size:clamp(34px,5vw,54px);margin:10px 0}.section-head p{color:var(--muted);line-height:1.7}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:linear-gradient(145deg,#171427,#0e0d18);border:1px solid var(--line);border-radius:18px;overflow:hidden}.art{height:190px;display:grid;place-items:center;background:radial-gradient(circle,#51317b 0,#191329 52%,#0e0d18 100%);color:#e6d7ff;font-size:52px}.cardbody{padding:19px}.card h3{margin:0 0 9px}.card p{color:var(--muted);line-height:1.65;font-size:14px}.small{font-size:12px;color:#c59aff;letter-spacing:1px;text-transform:uppercase}
.content{max-width:850px}.content p{color:var(--muted);line-height:1.85}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:24px}.panel label{display:block;color:#cfc7df;font-size:13px;margin:13px 0 7px}.panel input,.panel textarea{width:100%;padding:13px;border-radius:10px;border:1px solid #403452;background:#090812;color:white;font:inherit}.panel textarea{min-height:125px;resize:vertical}.panel input:focus,.panel textarea:focus{outline:1px solid var(--purple)}.empty{border:1px dashed #59466f;border-radius:18px;padding:45px;text-align:center;color:var(--muted);background:#ffffff05}
footer{border-top:1px solid #ffffff18;color:#817b91;text-align:center;padding:24px;font-size:12px}
@media(max-width:760px){.nav{align-items:flex-start;flex-direction:column}.nav nav{justify-content:flex-start}nav button{padding:9px}.hero{grid-template-columns:1fr;padding-top:25px}.visual{height:270px}.cards,.contact-grid{grid-template-columns:1fr}.page{padding-top:42px}.hero h1{letter-spacing:-2px}}
</style>
</head>
<body>
<header><div class="nav"><div class="brand">NEX<span>X</span> STUDIO</div><nav aria-label="Main navigation">
<button class="active" data-page="home">Home</button><button data-page="products">Products</button><button data-page="gallery">Gallery</button><button data-page="about">About Us</button><button data-page="reviews">Reviews</button><button data-page="contact">Contact / Order</button>
</nav></div></header>
<main>
<section class="page active" id="home"><div class="hero"><div><div class="eyebrow">3D assets • Game-ready creativity</div><h1>CREATE<br><span class="gradient">BEYOND</span><br>REALITY.</h1><p class="lead">NexX Studio creates detailed 3D models, characters, and digital assets for game developers, indie creators, and creative teams.</p><div class="actions"><button class="btn" data-go="products">Explore Products</button><button class="btn secondary" data-go="about">Discover NexX</button></div></div><div class="visual" aria-label="Abstract glowing 3D-inspired artwork"><div class="orb"></div></div></div></section>
<section class="page" id="products"><div class="section-head"><div class="eyebrow">Our collection</div><h1>Products</h1><p>Explore the current NexX Studio 3D asset collection. Contact us to ask about a product or place an order.</p></div><div class="cards">
<article class="card"><div class="art">🏎️</div><div class="cardbody"><div class="small">3D vehicle model</div><h3>Formula Racing Car</h3><p>A detailed Formula 1 racing car 3D model featuring an aerodynamic design, realistic racing components, and a professional motorsport-inspired appearance.</p><button class="btn" data-go="contact">Contact to Order</button></div></article>
<article class="card"><div class="art">🧍</div><div class="cardbody"><div class="small">3D character</div><h3>Streetwear Character</h3><p>A realistic male 3D character featuring a stylish denim jacket, cargo pants, sneakers, layered accessories, and detailed facial features.</p><button class="btn" data-go="contact">Contact to Order</button></div></article>
<article class="card"><div class="art">👟</div><div class="cardbody"><div class="small">3D character</div><h3>Urban Style Character</h3><p>A detailed male 3D character featuring a black oversized T-shirt, blue denim jeans, a stylish cap, sneakers, and a gold chain necklace.</p><button class="btn" data-go="contact">Contact to Order</button></div></article>
</div></section>
<section class="page" id="gallery"><div class="section-head"><div class="eyebrow">Visual showcase</div><h1>Gallery</h1><p>A preview space for NexX Studio renders, wireframes, and future 3D projects.</p></div><div class="cards"><div class="card"><div class="art">🏎️</div><div class="cardbody"><h3>Racing Vehicle</h3><p>3D model preview placeholder</p></div></div><div class="card"><div class="art">◇</div><div class="cardbody"><h3>Character Model</h3><p>3D model preview placeholder</p></div></div><div class="card"><div class="art">✦</div><div class="cardbody"><h3>Wireframe Study</h3><p>Wireframe preview placeholder</p></div></div></div></section>
<section class="page" id="about"><div class="content"><div class="eyebrow">Who we are</div><h1>About NexX Studio</h1><p>NexX Studio is a 3D asset studio focused on creating digital models and creative resources for game development and interactive experiences.</p><p>Our goal is to help developers, independent creators, and studios bring their ideas to life with useful, thoughtfully designed 3D assets.</p><h2 class="gradient">Create Beyond Reality.</h2></div></section>
<section class="page" id="reviews"><div class="section-head"><div class="eyebrow">Community feedback</div><h1>Reviews</h1><p>Customer feedback will appear here as genuine reviews become available.</p></div><div class="empty">No reviews have been published yet.</div></section>
<section class="page" id="contact"><div class="section-head"><div class="eyebrow">Let's work together</div><h1>Contact / Order</h1><p>Interested in an asset? Send a message with the product name and your questions.</p></div><div class="contact-grid"><div class="panel"><h2>Get in touch</h2><p class="lead">Email: <a href="mailto:umarrakeeb44@gmail.com" style="color:#c59aff">umarrakeeb44@gmail.com</a></p><p class="lead">Use the form to prepare an order enquiry in your email app.</p></div><form class="panel" id="contactForm"><label for="name">Your name</label><input id="name" required placeholder="Name"><label for="email">Your email</label><input id="email" type="email" required placeholder="you@example.com"><label for="product">Product / subject</label><input id="product" placeholder="Which asset are you interested in?"><label for="message">Message</label><textarea id="message" required placeholder="Write your message..."></textarea><button class="btn" type="submit">Prepare Email</button></form></div></section>
</main><footer>© <span id="year"></span> NexX Studio · Create Beyond Reality.</footer>
<script>
const pages=[...document.querySelectorAll('.page')], navButtons=[...document.querySelectorAll('nav button')];
function showPage(name){if(!pages.some(p=>p.id===name))name='home';pages.forEach(p=>p.classList.toggle('active',p.id===name));navButtons.forEach(b=>b.classList.toggle('active',b.dataset.page===name));history.replaceState(null,'','#'+name);window.scrollTo({top:0,behavior:'smooth'});}
navButtons.forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
document.querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.go)));
window.addEventListener('hashchange',()=>showPage(location.hash.slice(1)));
if(location.hash)showPage(location.hash.slice(1));
document.getElementById('year').textContent=new Date().getFullYear();
document.getElementById('contactForm').addEventListener('submit',e=>{e.preventDefault();const v=id=>document.getElementById(id).value;const subject=encodeURIComponent('NexX Studio enquiry: '+(v('product')||'General'));const body=encodeURIComponent('Name: '+v('name')+'\nEmail: '+v('email')+'\nProduct: '+v('product')+'\n\n'+v('message'));location.href='mailto:umarrakeeb44@gmail.com?subject='+subject+'&body='+body;});
</script>
</body></html>
